generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Contato
  nome     String
  email    String
  whatsapp String

  // Contexto do formulário
  context     String
  subcategory String

  // Preferências musicais
  musicalStyle String
  voiceType    String
  emotion      String

  // Status operacional
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // Produto escolhido (preenchido na tela de produtos)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Token de acesso à página de upload de fotos (sem login), gerado no pagamento
  photo_token String? @unique @db.Uuid

  // Letra com IA (etapa "Sua letra" na área do cliente, pós-pagamento)
  lyricsDraft          String?   @db.Text
  lyricsApproved       Boolean   @default(false)
  lyricsApprovedAt     DateTime?
  lyricsReprocessCount Int       @default(0)

  // Geração da música via Suno (KIE). sunoStatus: GENERATING|READY|FAILED
  sunoTaskId String?
  sunoStatus String?
  sunoError  String?
  sunoTracks Json?

  // Relações
  answers        OrderAnswer[]
  payment        Payment?
  generatedMusic GeneratedMusic?
  photos         OrderPhoto[]

  @@map("orders")
}

// ============================================================
// FOTOS DO CLIENTE (exibidas no player) — upload pós-pagamento
// ============================================================

model OrderPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String
  url          String
  storage_path String
  is_cover     Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_photos")
}

// ============================================================
// RESPOSTAS DINÂMICAS (uma linha por pergunta/resposta)
// Permite adicionar/remover perguntas sem migração
// ============================================================

model OrderAnswer {
  id          String @id @default(cuid())
  orderId     String
  question    String
  answer      String @db.Text
  position    Int
  context     String
  subcategory String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_answers")
}

// ============================================================
// PRODUTOS (gerenciados pelo admin)
// ============================================================

model Product {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  price       Float
  imageUrl    String?
  active      Boolean @default(true)
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  category    String  @default("DIGITAL")
  weight_g    Int?
  height_cm   Int?
  width_cm    Int?
  length_cm   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("products")
}

// ============================================================
// PAGAMENTOS
// ============================================================

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  amount Float
  status PaymentStatus @default(UNPAID)

  // Mercado Pago
  mpPaymentId    String?
  mpPreferenceId String?
  mpStatus       String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ============================================================
// MÚSICA GERADA (publicada pelo admin após produção)
// ============================================================

model GeneratedMusic {
  id      String @id @default(cuid())
  orderId String @unique

  mp3Url     String?
  lyrics     String? @db.Text
  lyricsLrc  String? @db.Text
  imageUrl   String?
  personName String?
  musicName  String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("generated_music")
}

// ============================================================
// SESSÕES ANÔNIMAS DO WIZARD (sem login)
// ============================================================

model WizardSession {
  id        String   @id @db.Uuid
  step      Int      @default(1)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("wizard_sessions")
}

// ============================================================
// CONFIG DO COMPOSITOR IA (prompt editável no admin — linha única)
// ============================================================

model ComposerSettings {
  id        Int      @id @default(1)
  prompt    String   @db.Text
  model     String   @default("gemini-flash-latest")
  location  String   @default("global")
  updatedAt DateTime @default(now()) @updatedAt

  @@map("composer_settings")
}

// ============================================================
// ENUMS
// ============================================================

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  DELIVERED
  ABANDONED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
